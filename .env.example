# ==============================================================================
# SnapMarket AI — Environment Variables Configuration
# ==============================================================================
# Note: SnapMarket AI is designed with an autonomous Demo / Fallback Mode.
# The application runs fully end-to-end WITHOUT requiring any external API keys.
# To connect live cloud AI providers, populate the keys below.
# ==============================================================================

# Official Meta Model API (Meta Muse Suite)
# - Understanding & Attributes: Meta Muse Spark (muse-spark-1.3)
# - Image Conditioning & Studio Editing: Meta Muse Image (muse-image-1.0)
# Read strictly server-side. Never exposed to browser or client code.
MODEL_API_KEY=your_model_api_key_here
META_MODEL_API_ENDPOINT=https://api.meta.ai/v1

# Modal Serverless Shelf Product Segmentation Service
# Deploy with: modal deploy modal/segmentation_app.py
MODAL_SEGMENTATION_ENDPOINT=https://your-username--snapmarket-shelf-segmentation-fastapi-app.modal.run

# Optional / Legacy Fallback Endpoints
META_SAM_ENDPOINT=https://model-endpoint.api.baseten.co/production/predict
FIREWORKS_API_KEY=your_fireworks_api_key_here

# App Deployment URL (defaults to http://localhost:3000 in local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
